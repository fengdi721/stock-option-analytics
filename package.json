{
  "name": "stock-option-analytics",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "test": "node --test test/*.test.ts",
    "demo": "node src/cli.ts quote-payoff fixtures/quotes.synthetic.csv fixtures/quote-request.json",
    "typecheck": "tsc --noEmit",
    "check": "npm run format:check && npm run lint && npm run architecture:check && npm run typecheck && npm test",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "architecture:check": "depcruise --config .dependency-cruiser.mjs src --output-type err"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "dependency-cruiser": "18.7.0",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1"
  }
}
